# Production env template — copy values into Render dashboard only.
# Never commit real secrets.

NODE_ENV=production
LOG_LEVEL=info
PORT=10000

FRONTEND_URL=https://ecoweathersme.onrender.com
NEXT_PUBLIC_APP_URL=https://ecoweathersme.onrender.com
BACKEND_API_URL=https://backsme.onrender.com
PUBLIC_BACKEND_URL=https://backsme.onrender.com

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Session pooler (IPv4-friendly for Render)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

JWT_SECRET=generate-with-openssl-rand-hex-64
GROQ_API_KEY=your-groq-key
OPENWEATHER_API_KEY=your-openweather-key
