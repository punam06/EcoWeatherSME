# EcoWeatherSME — root env template (copy to .env at repo root or backend/.env)
# The TypeScript backend loads backend/.env first, then this file.

# ─── Server ───────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ─── Groq AI (required in production) ─────────────────────
GROQ_API_KEY=your-groq-api-key-here

# ─── Supabase (required for orders / DB-backed agent flows) ─
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── CORS / frontend ──────────────────────────────────────
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_API_URL=http://localhost:5001

# ─── Weather API (required in production) ─────────────────
OPENWEATHER_API_KEY=your-openweather-api-key-here
# Optional alias (same behavior as OPENWEATHER_API_KEY in backend)
# WEATHER_API_KEY=
