{
  "name": "eco-weather-sme-backend",
  "version": "1.0.0",
  "description": "EcoSortha AI (ClimateShield) Microclimate and ESG Backend Logic",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "seed:hazards": "ts-node scripts/seed-zone-hazards.ts",
    "seed:data": "ts-node scripts/seed-data.ts",
    "test:math": "ts-node scripts/test-math.ts",
    "demo:microclimate": "ts-node scripts/demo-microclimate.ts",
    "backend:install": "cd backend && npm install",
    "backend:start": "cd backend && npm start",
    "backend:dev": "cd backend && npm run dev",
    "frontend:serve": "python3 -m http.server 3000 --directory \"Frontend and UI\"",
    "dev": "echo '🚀 Starting development environment...' && (cd backend && npm start &) && npm run frontend:serve",
    "setup": "npm install && npm run backend:install"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.4",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
