{
  "name": "eco-weather-sme-backend",
  "version": "1.0.0",
  "description": "ClimaLogix AI (ClimateShield) Microclimate and ESG Backend Logic",
  "main": "index.js",
  "scripts": {
    "build": "tsc && node scripts/compile-frontend.js",
    "seed:hazards": "ts-node scripts/seed-zone-hazards.ts",
    "seed:data": "ts-node scripts/seed-data.ts",
    "test:math": "ts-node scripts/test-math.ts",
    "demo:microclimate": "ts-node scripts/demo-microclimate.ts",
    "backend:install": "cd backend && npm install",
    "backend:start": "cd backend && npm start",
    "backend:dev": "cd backend && npm run dev",
    "frontend:serve": "python3 -m http.server 3000 --directory \"Frontend and UI\"",
    "dev": "echo '🚀 Starting development environment...' && (cd backend && npm run dev &) && npm run frontend:serve",
    "db:seed": "psql \"$DATABASE_URL\" -f db/seeds/001_zones.sql",
    "db:seed:zones": "psql \"$DATABASE_URL\" -f db/seeds/001_zones.sql",
    "db:seed:users": "psql \"$DATABASE_URL\" -f db/seeds/002_demo_users.sql",
    "db:seed:batches": "psql \"$DATABASE_URL\" -f db/seeds/003_demo_batches.sql",
    "db:seed:readings": "psql \"$DATABASE_URL\" -f db/seeds/004_demo_iot_readings.sql",
    "db:seed:all": "npm run db:seed:zones && npm run db:seed:users && npm run db:seed:batches && npm run db:seed:readings",
    "setup": "npm install && npm run backend:install"
  },
  "dependencies": {
    "@babel/parser": "^7.29.7",
    "@supabase/supabase-js": "^2.43.4",
    "dotenv": "^16.4.5",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@types/node": "^20.14.2",
    "supabase": "^2.105.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
