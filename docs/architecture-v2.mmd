  receipt --> feedbackCapture
  feedbackCapture --> feedbackStore
  feedbackStore --> db
  feedbackStore --> recEngine
  productRank --> recEngine
  recEngine --> api
  recEngine --> sellerInsights
  sellerInsights --> smeFeedbackHub
  feedbackStore --> smeFeedbackHub

  %% ═══════════════════════════════════════════════════════════
