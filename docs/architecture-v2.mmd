  owner --> login
  buyer --> login
  warehouse --> login
  delivery --> login
  admin --> login
  login --> roles --> session --> permissions

  %% AUTH → PLATFORM
  permissions --> api

  %% ═══════════════════════════════════════════════════════════
  %% PLATFORM INFRA CONNECTIONS
  %% ═══════════════════════════════════════════════════════════
  api --> db
  api --> edge
  api --> llm
  api --> weatherApi
  api --> realtimeInfra
  db --> realtimeInfra

  %% ═══════════════════════════════════════════════════════════
  %% SME PORTAL (IMPROVED) — internal links
  %% ═══════════════════════════════════════════════════════════
  permissions --> smeDashboard
  smeDashboard --> batchMgmt
  smeDashboard --> spotPricing
  smeDashboard --> smeNotifCenter
  smeDashboard --> smeFeedbackHub
  smeDashboard --> carbonDashboard
  carbonDashboard --> esgReport

  %% ═══════════════════════════════════════════════════════════
