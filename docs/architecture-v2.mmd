  order --> weather
  weather --> weatherApi
  weather --> micro
  micro --> routeRisk
  routeRisk --> dvs
  dvs --> spotPricing
  dvs --> productRank

  %% ═══════════════════════════════════════════════════════════
  %% AI DECISION FLOW
  %% ═══════════════════════════════════════════════════════════
  checkout --> intentEngine
  intentEngine --> ragEngine
  ragEngine --> db
  ragEngine --> assistant
  assistant --> llm
  trustScore --> aiDecision
  dvs --> aiDecision
  order --> aiDecision
  aiDecision --> costShield
