flowchart TB
  %% ============================================================
  %% EcoSortha AI (ClimateShield) — Architecture v2
  %% NEW: Real-Time Notifications, Feedback & Recommendation,
  %%      Improved SME Page, Carbon Credits from ESG
  %% Deployment-safe: Render + Supabase unchanged
  %% ============================================================

  %% ── ACTORS ──────────────────────────────────────────────────
  subgraph actors["👥 Users + External Actors"]
    owner["🏭 SME Owner"]
    buyer["🛒 Buyer / Customer"]
    warehouse["🏢 Warehouse / Industry"]
    delivery["🚚 Delivery Partner\nPathao / Uber / Local"]
    admin["🔐 Admin"]
  end

  %% ── AUTH LAYER ───────────────────────────────────────────────
  subgraph auth["🔒 Authentication + Access Control Layer"]
    login["Login / Signup"]
    roles["Role-Based Access Control\nSME Owner · Buyer · Warehouse · Delivery · Admin"]
    session["Secure Session / JWT"]
    permissions["Permissions + Audit Logs"]
  end

  %% ── SME PORTAL (IMPROVED) ────────────────────────────────────
  subgraph sme["🖥️ Improved SME Owner Portal"]
    direction TB
    smeDashboard["📊 SME Dashboard\nKPI cards · spoilage · revenue · DVS"]
    batchMgmt["📦 Batch Registry & IoT Readings\npH · EC · temp · fermentation days · QR cert"]
    spotPricing["🏷️ Dynamic Spot Pricing\ncrossed-out price · clearance badge · DVS < 70"]
    smeNotifCenter["🔔 Notification Center\nalerts · confirmations · system events"]
    smeFeedbackHub["⭐ Feedback Hub\nrate buyer · view reviews · respond"]
    carbonDashboard["🌿 Carbon Credits Dashboard\nScope 3 offsets · milestones · certificates"]
    esgReport["📋 ESG Report Generator\nplastic_offset_kg · carbon_seq_kg · BARI compliance"]
  end

  %% ── COMMERCE LAYER ───────────────────────────────────────────
  subgraph commerce["🛒 Commerce Layer"]
    marketplace["Marketplace\nproduct listing · catalog"]
    order["Order + Destination"]
    registry["Batch Registry"]
    checkout["Voice / Text Checkout"]
  end

  %% ── TRUST LAYER ──────────────────────────────────────────────
  subgraph trust["🔬 Product Trust Layer"]
    iot["IoT / QA Readings\npH · EC · temp · fermentation days"]
    verify["Product Verification\nBARl-Aligned score"]
    trustScore["Trust Score\ndeterministic certificate"]
    qrCert["QR Certificate\ndownloadable · scannable"]
  end

  %% ── CLIMATE SUPPLY CHAIN ─────────────────────────────────────
  subgraph climate["🌡️ Climate Supply Chain Layer"]
    weather["Weather Signals\nOpenWeather API"]
    micro["Microclimate Intelligence\nMERM / UHI exposure"]
    routeRisk["Route + Zone Risk\nBUET-UHI thermal path"]
    dvs["Delivery Viability Score\nDVS engine"]
  end

  %% ── AI DECISION LAYER ────────────────────────────────────────
  subgraph decision["🤖 AI Decision Layer"]
    assistant["AI Assistant / Copilot\nBangla Voice RAG · Groq Llama-3.3"]
    intentEngine["Intent Classifier\nagentOrchestrator.service.ts"]
    ragEngine["RAG Engine\nbari_knowledge_chunks · pgvector"]
    costShield["AI CostShield\nbudget · tokens · ROI tracking"]
    aiDecision["AI Decision Engine\naccept · delay · reroute · reject"]
  end

  %% ── RECOMMENDATION ENGINE (NEW) ──────────────────────────────
  subgraph recommend["💡 Feedback & Recommendation System  ✨ NEW"]
    feedbackCapture["📝 Buyer Feedback Capture\nrating · review · delivery experience"]
    feedbackStore["💾 Feedback Store\nfeedback_logs · sentiment_score"]
    recEngine["🎯 AI Recommendation Engine\naiRecommend.route.ts · personalized results"]
    productRank["📈 Product Ranking\nby trust score + feedback + DVS"]
    sellerInsights["📊 Seller Insights\navg rating · return rate · peak demand"]
  end

  %% ── REAL-TIME NOTIFICATIONS (NEW) ────────────────────────────
  subgraph realtime["⚡ Real-Time Notification System  ✨ NEW"]
    realtimeChannel["Supabase Realtime Channel\nPostgres CDC · broadcast"]
    notifRouter["Notification Router\nevent type → recipient role"]
    smeAlert["🔴 SME Alerts\nDVS breach · order placed · feedback received"]
    buyerAlert["🟢 Buyer Alerts\norder confirmed · dispatch · delivery update"]
    warehouseAlert["🟡 Warehouse Alerts\npickup request · packaging change"]
    toastUI["🖥️ In-App Toast / Banner\nrealtime push → frontend listener"]
  end

  %% ── CARBON CREDIT / ESG ENGINE (NEW) ─────────────────────────
  subgraph carbon["🌍 Carbon Credit & ESG Reporting  ✨ NEW"]
    esgMetrics["ESG Metrics Ledger\nesg_metrics table · monthly milestones"]
    carbonCalc["Carbon Calculator\nplastic_offset_kg · carbon_seq_kg · biochar"]
    scope3["Scope 3 Compliance Pack\ncircular milestone bundles"]
    creditCert["🏅 Digital Carbon Credit Certificate\ndownloadable · verifiable hash"]
    carbonMarket["🌐 Carbon Marketplace Bridge\ncorporate buyer offset purchase"]
    greenScore["💳 Green Finance Score\nBARl compliance → micro-loan eligibility"]
  end

  %% ── EXECUTION LAYER ──────────────────────────────────────────
  subgraph execution["⚙️ Execution Layer"]
    dispatchRec["Dispatch Recommendation\naccept · delay · reroute · packaging · reject"]
    confirm["SME / Warehouse Confirmation"]
    dispatch["Climate-Safe Dispatch"]
    receipt["Customer Receipt Confirmation"]
  end

  %% ── PLATFORM INFRASTRUCTURE (DEPLOYMENT-SAFE) ────────────────
  subgraph platform["🏗️ Platform Infrastructure  [DEPLOYMENT SAFE]"]
    api["☁️ Express API\nbackend/src/app.ts → Render"]
    db[("🗄️ Supabase PostgreSQL\n+ pgvector + RLS Policies")]
    edge["⚡ Supabase Edge Functions\nai-processing · climate-dvs · trust-score"]
    llm["🧠 Groq LLM Provider\nLlama-3.3-70b-versatile"]
    weatherApi["🌦️ OpenWeather / Climate APIs"]
    realtimeInfra["📡 Supabase Realtime\nPostgres Changes broadcast"]
  end

  %% ── BUSINESS INTELLIGENCE ────────────────────────────────────
  subgraph intelligence["📊 Business Intelligence Layer"]
    impactDash["Impact Dashboard\nspoilage prevented · routes saved"]
    roiTracker["AI ROI + Spoilage Prevented"]
    auditLog["Audit Trail\nagent_interaction_logs · dvs_logs"]
  end

  %% ═══════════════════════════════════════════════════════════
