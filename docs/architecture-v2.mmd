  realtimeInfra --> realtimeChannel
  realtimeChannel --> notifRouter
  notifRouter --> smeAlert
  notifRouter --> buyerAlert
  notifRouter --> warehouseAlert
  smeAlert --> toastUI
  buyerAlert --> toastUI
  warehouseAlert --> toastUI
  toastUI --> smeNotifCenter
  dvs --> realtimeChannel
  order --> realtimeChannel
  feedbackCapture --> realtimeChannel
  dispatch --> realtimeChannel

