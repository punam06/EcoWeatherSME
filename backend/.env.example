# ─── Server ───────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ─── Groq AI (via OpenAI SDK) ─────────────────────────────
GROQ_API_KEY=

# ─── Supabase ─────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── JWT Authentication ────────────────────────────────────
# Generate a strong secret: openssl rand -hex 64
JWT_SECRET=change-me-to-a-long-random-string-min-64-chars
# Optional: defaults to JWT_SECRET + '_refresh'
JWT_REFRESH_SECRET=

# ─── CORS ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Weather API ──────────────────────────────────────────
OPENWEATHER_API_KEY=

