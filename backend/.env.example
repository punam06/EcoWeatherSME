# ─── Server ───────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ─── Groq AI (required in production) ─────────────────────
GROQ_API_KEY=

# ─── Supabase (required for orders / catalog persistence) ─
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── JWT Authentication ────────────────────────────────────
# Generate a strong secret: openssl rand -hex 64
JWT_SECRET=change-me-to-a-long-random-string-min-64-chars
# Optional: defaults to JWT_SECRET + '_refresh'
JWT_REFRESH_SECRET=

# ─── CORS ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# Optional extra allowed origin (defaults include FRONTEND_URL)
# CORS_ORIGIN=

# ─── Weather API (required in production) ─────────────────
# Primary key used by app.ts startup check and weather routes.
OPENWEATHER_API_KEY=
# Optional alias also read by weather.service.ts and agent orchestrator
# WEATHER_API_KEY=
