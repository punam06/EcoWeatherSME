{
  "name": "ecosortha-backend",
  "version": "2.0.0",
  "description": "EcoSortha AI (ClimateShield) — TypeScript Express Backend",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
