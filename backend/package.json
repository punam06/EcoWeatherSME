{
  "name": "ecosortha-backend",
  "version": "2.0.0",
  "description": "EcoSortha AI (ClimateShield) — TypeScript Express Backend",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc --ignoreDeprecations 6.0",
    "start": "node dist/app.js",
    "dev": "ts-node --transpile-only src/app.ts",
    "dev:watch": "ts-node-dev --respawn --transpile-only src/app.ts",
    "lint": "tsc --noEmit --ignoreDeprecations 6.0",
    "legacy": "node index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.4",
    "argon2": "^0.44.0",
    "axios": "^1.17.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "franc-min": "^6.2.0",
    "groq-sdk": "^0.33.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "node-fetch": "^2.7.0",
    "pg": "^8.11.5",
    "qrcode": "^1.5.4",
    "uuid": "^9.0.1",
    "ws": "^8.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20.14.2",
    "@types/node-fetch": "^2.6.11",
    "@types/pg": "^8.11.6",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^9.0.8",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
